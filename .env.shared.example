# Shared Environment Configuration
# Copy this file to .env.shared and customize for your environment
# This file contains non-sensitive configuration shared across the team

# Output directory for data files
OUTPUT_DIR="data"
# OUTPUT_DIR_data="target_lists"
# OUTPUT_DIR_ppp="psl_lists"
# OUTPUT_DIR_ppc="ppc_lists"

# Maximum execution time to terminate the calculation (default: 900s = 15min)
# Set to 0 for no limit
MAX_EXETIME=1800

# Maximum number of pointings to be considered (default: 200)
# MAX_NPPC=100

# Email settings (optional)
# EMAIL_FROM=your-email@example.com
# EMAIL_TO=recipient@example.com
# SMTP_SERVER=mail.example.com

# Suppress output of netflow
# 0: verbose
# 1: quiet
PPP_QUIET=1

# Target clustering algorithm
# Options: HDBSCAN, DBSCAN, or FAST_HDBSCAN (recommended)
# CLUSTERING_ALGORITHM=HDBSCAN
CLUSTERING_ALGORITHM=FAST_HDBSCAN

# ILP solver used for the pointing simulation
# Options: gurobi (needs a licence), highs (open source, no licence)
SOLVER_BACKEND=gurobi

# User announcement file
ANN_FILE="user_announcement.md"

# Upload ID database file
UPLOADID_DB="upload_id.sqlite"

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL="DEBUG"
LOG_LEVEL="INFO"

# ========================================
# Flux Range Validation Settings
# ========================================

# Flux range check based on AB magnitude
# These settings validate that flux values fall within expected magnitude ranges
# Leave empty or comment out to disable range checking

# Minimum AB magnitude (brightest limit) for queue observation type
# Targets brighter than this value will trigger a warning
# Example: MIN_FLUXMAG_QUEUE=10.0
MIN_FLUXMAG_QUEUE=

# Minimum AB magnitude (brightest limit) for classical observation type
# Targets brighter than this value will trigger a warning
# Example: MIN_FLUXMAG_CLASSICAL=12.0
MIN_FLUXMAG_CLASSICAL=

# Minimum AB magnitude (brightest limit) for filler observation type
# Targets brighter than this value will trigger a warning
# Example: MIN_FLUXMAG_FILLER=15.0
MIN_FLUXMAG_FILLER=

# Maximum AB magnitude (faintest limit)
# Targets fainter than this value will trigger a warning
# Applies to all observation types
# Example: MAX_FLUXMAG=30.0
MAX_FLUXMAG=

# ========================================
# PPP Performance Optimization Settings
# ========================================

# PPP Timing Verbose: Detailed timing logs (0=off, 1=on)
# When enabled, measures execution time for each major PPP stage
# Useful for identifying performance bottlenecks
# Enable when profiling PPP performance, disable for production use
PPP_TIMING_VERBOSE=0
