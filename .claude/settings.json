{
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(black:*)",
      "Bash(ty check:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run black:*)",
      "Bash(uv run ty:*)",
      "Bash(uv sync:*)",
      "Bash(pfs-uploader-cli validate:*)",
      "Bash(uv run pfs-uploader-cli validate:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Read(.env.private)",
      "Read(.env.docker)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  }
}
