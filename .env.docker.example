# Docker Build Configuration
# Copy this file to .env.docker and customize for your environment
# .env.docker is gitignored and will be loaded automatically by build-container.sh

# Docker Hub username
# Default: myuser
DOCKER_USER=myuser_example

# Docker image name
# Default: pfs_target_uploader
DOCKER_IMAGE=pfs_target_uploader

# Docker image tag
# Default: latest
DOCKER_TAG=latest

# Push to Docker Hub after build
# Set to "true" to enable push, "false" to build locally only
# Default: false
DOCKER_PUSH=true

# Build platforms (comma-separated)
# Default: linux/amd64,linux/arm64
# Note: Using only linux/amd64 to avoid PyQt5 build issues on arm64
DOCKER_PLATFORMS=linux/amd64
